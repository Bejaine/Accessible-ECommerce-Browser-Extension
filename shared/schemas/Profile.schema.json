{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile",
  "description": "Stays on the device (browser.storage.local). Only `prefs` leaves the device.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "conditions", "prefs"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "conditions": {
      "title": "Conditions",
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "speech", "motor", "ageing", "colour"],
      "properties": {
        "visual": { "$ref": "#/$defs/ConditionState" },
        "speech": { "$ref": "#/$defs/ConditionState" },
        "motor": { "$ref": "#/$defs/ConditionState" },
        "ageing": { "$ref": "#/$defs/ConditionState" },
        "colour": { "$ref": "#/$defs/ColourConditionState" }
      }
    },
    "prefs": { "$ref": "#/$defs/Prefs" }
  },
  "$defs": {
    "ConditionState": {
      "title": "ConditionState",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "active", "source"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "active": { "type": "boolean" },
        "source": { "title": "ConditionSource", "type": "string", "enum": ["inferred", "user"] }
      }
    },
    "ColourConditionState": {
      "title": "ColourConditionState",
      "description": "Colour vision is never inferred, so source is always user.",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "active", "source"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "active": { "type": "boolean" },
        "source": { "type": "string", "const": "user" }
      }
    },
    "Prefs": {
      "title": "Prefs",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "tts_rate",
        "text_scale",
        "verbosity",
        "lite_mode",
        "text_first",
        "switch_key",
        "preferred_payment"
      ],
      "properties": {
        "lang": { "$ref": "common.schema.json#/$defs/Lang" },
        "tts_rate": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "text_scale": { "type": "number", "minimum": 1.0, "maximum": 3.0 },
        "verbosity": { "$ref": "#/$defs/Verbosity" },
        "lite_mode": { "type": "boolean" },
        "text_first": {
          "type": "boolean",
          "description": "Prefer text over voice (a preference, not an impairment signal)."
        },
        "switch_key": {
          "type": "string",
          "minLength": 1,
          "description": "KeyboardEvent.code used as the single switch, e.g. Space."
        },
        "preferred_payment": {
          "anyOf": [{ "$ref": "#/$defs/PaymentMethod" }, { "type": "null" }]
        }
      }
    },
    "Verbosity": { "title": "Verbosity", "type": "string", "enum": ["short", "normal"] },
    "PaymentMethod": {
      "title": "PaymentMethod",
      "type": "string",
      "enum": ["upi", "saved_card", "cod"]
    }
  }
}
