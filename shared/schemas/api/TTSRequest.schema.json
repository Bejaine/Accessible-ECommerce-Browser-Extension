{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TTSRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "text", "lang"],
  "properties": {
    "schema_version": {
      "$ref": "../common.schema.json#/$defs/SchemaVersion"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "$ref": "../common.schema.json#/$defs/Lang"
    },
    "voice": {
      "type": "string",
      "description": "Request option."
    }
  }
}
