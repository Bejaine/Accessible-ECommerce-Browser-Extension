{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HealthResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "mock", "version"],
  "properties": {
    "schema_version": {
      "$ref": "../common.schema.json#/$defs/SchemaVersion"
    },
    "status": {
      "type": "string",
      "const": "ok"
    },
    "mock": {
      "type": "boolean"
    },
    "version": {
      "type": "string"
    }
  }
}
