{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TTSResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audio_base64", "encoding", "lang", "cached"],
  "properties": {
    "schema_version": {
      "$ref": "../common.schema.json#/$defs/SchemaVersion"
    },
    "audio_base64": {
      "type": "string"
    },
    "encoding": {
      "type": "string",
      "enum": ["wav", "mp3", "ogg"]
    },
    "lang": {
      "$ref": "../common.schema.json#/$defs/Lang"
    },
    "cached": {
      "type": "boolean"
    }
  }
}
