{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASRRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lang", "audio_base64", "encoding"],
  "properties": {
    "schema_version": {
      "$ref": "../common.schema.json#/$defs/SchemaVersion"
    },
    "lang": {
      "$ref": "../common.schema.json#/$defs/Lang"
    },
    "audio_base64": {
      "type": "string"
    },
    "encoding": {
      "type": "string",
      "enum": ["opus", "webm", "wav"]
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 8000,
      "description": "Request option."
    },
    "mic_level": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Request option: our own RMS level, to tell silence from unclear speech."
    }
  }
}
