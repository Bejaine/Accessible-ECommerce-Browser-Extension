{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OCRRequest",
  "description": "Exactly one of image_url or image_base64.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lang"],
  "properties": {
    "schema_version": {
      "$ref": "../common.schema.json#/$defs/SchemaVersion"
    },
    "image_url": {
      "type": "string"
    },
    "image_base64": {
      "type": "string"
    },
    "lang": {
      "$ref": "../common.schema.json#/$defs/Lang"
    }
  },
  "oneOf": [
    {
      "required": ["image_url"]
    },
    {
      "required": ["image_base64"]
    }
  ]
}
