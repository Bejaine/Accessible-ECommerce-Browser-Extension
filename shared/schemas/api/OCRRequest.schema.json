{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OCRRequest",
  "description": "Exactly one of image_url or image_base64.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lang"],
  "properties": {
    "image_url": { "type": ["string", "null"] },
    "image_base64": { "type": ["string", "null"] },
    "lang": { "type": "string" }
  }
}
