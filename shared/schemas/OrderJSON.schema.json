{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderJSON",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "items", "status", "dates", "available_actions"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "id": {
      "type": "string",
      "pattern": "^ORDER_[0-9]+$",
      "description": "Placeholder (ORDER_n), never the real order id."
    },
    "items": {
      "type": "array",
      "items": {
        "title": "OrderItem",
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "quantity", "price", "product_url"],
        "properties": {
          "title": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "price": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Money" }, { "type": "null" }] },
          "product_url": { "type": ["string", "null"] }
        }
      }
    },
    "status": {
      "title": "OrderStatus",
      "type": "string",
      "enum": [
        "placed",
        "shipped",
        "out_for_delivery",
        "delivered",
        "cancelled",
        "returned",
        "unknown"
      ]
    },
    "dates": {
      "title": "OrderDates",
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered", "expected_delivery", "delivered"],
      "properties": {
        "ordered": { "type": ["string", "null"], "format": "date" },
        "expected_delivery": { "type": ["string", "null"], "format": "date" },
        "delivered": { "type": ["string", "null"], "format": "date" }
      }
    },
    "available_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["track", "return", "cancel"] }
    }
  }
}
