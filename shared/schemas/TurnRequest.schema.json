{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "input", "page", "prefs", "history"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "session_id": { "type": "string" },
    "input": {
      "title": "TurnInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "lang", "target_id", "phrase_id", "asr_meta"],
      "properties": {
        "kind": {
          "title": "InputKind",
          "type": "string",
          "enum": ["voice", "text", "phrase", "switch"]
        },
        "text": {
          "type": ["string", "null"],
          "description": "In the user's own language; the backend translates inside /turn. The client never pre-translates."
        },
        "lang": { "$ref": "common.schema.json#/$defs/Lang" },
        "target_id": {
          "type": ["string", "null"],
          "description": "ActionTarget chosen by switch/tap."
        },
        "phrase_id": { "type": ["string", "null"], "description": "Phrase chip chosen." },
        "asr_meta": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/AsrMeta" }, { "type": "null" }]
        }
      }
    },
    "page": { "$ref": "PageContext.schema.json" },
    "prefs": { "$ref": "Profile.schema.json#/$defs/Prefs" },
    "history": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "title": "HistoryTurn",
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "text"],
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant"] },
          "text": { "type": "string", "description": "In English." }
        }
      }
    }
  }
}
