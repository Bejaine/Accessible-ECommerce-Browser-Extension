# Language API tokens live in backend/config/models.local.json (see docs/language-api.md)
LANGUAGE_MODELS_FILE=backend/config/models.local.json
# 0 skips warming every language model at backend startup (useful with --reload and MOCK=0)
LANGUAGE_WARMUP=1
# Gemini (Track C): product photo descriptions. Model is an optional override.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq (Track C): section summaries and /turn. Models are optional overrides.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_S=20
# 1 = save every real LLM response to fixtures/llm/ (for re-recording test fixtures)
LLM_RECORD=0
SERPAPI_API_KEY=
MOCK=1
